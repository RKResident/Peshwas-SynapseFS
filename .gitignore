# --- Generated test fixtures -------------------------------------------------
# The PS explicitly asks that large synthetic fixtures stay OUT of commit
# history and be regenerated by script instead. `tools/gen_fixtures.py` is the
# script; this keeps its output from ever being staged by accident.
fixtures/
*.safetensors
*.pt
*.bin
personal_testing/

# --- Repositories created during manual testing ------------------------------
.synapse/
*.synapse/

# --- Benchmark output --------------------------------------------------------
bench-results/
*.bench.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- Environments ------------------------------------------------------------
.venv/
venv/
env/

# --- Editors -----------------------------------------------------------------
.idea/
.vscode/
*.swp
