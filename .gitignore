# --- Generated test fixtures -------------------------------------------------
# The PS explicitly asks that large synthetic fixtures stay OUT of commit
# history and be regenerated by script instead. `tools/gen_fixtures.py` is the
# script; this keeps its output from ever being staged by accident.
fixtures/
*.safetensors
*.pt
*.bin
personal_testing/

# Downloaded datasets and training output from tools/train_stl10.py. The STL-10
# archive alone is ~2.5 GB (it bundles 100k unlabeled images), so this is the
# difference between a clone and an accident.
data/
checkpoints/

# --- Repositories created during manual testing ------------------------------
.synapse/
*.synapse/
tools/checkpoints
tools/data
tools/benchmark

